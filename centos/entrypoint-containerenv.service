[Unit]
Description=Save container environment vars
Before=entrypoint-before-ssh.service

[Service]
Type=oneshot
ExecStart=/usr/bin/bash -c 'xargs --null --max-args=1 echo < /proc/1/environ > /run/container-env'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target

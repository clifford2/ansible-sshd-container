[Unit]
Description=Run entrypoint script before SSH
Before=sshd.service
After=entrypoint-containerenv.service

[Service]
EnvironmentFile=/run/container-env
Type=oneshot
ExecStart=/usr/local/bin/entrypoint.sh
RemainAfterExit=yes
# Restart=on-failure
# StartLimitIntervalSec=30
# StartLimitBurst=5

[Install]
WantedBy=multi-user.target
